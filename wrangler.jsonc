{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novavp1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b2374890-b938-4472-8a8c-69e37269f96b","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "257bd15dcf684cd0a2b25c8e11883c2f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
